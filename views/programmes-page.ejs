<%- include('partials/head') %>
<body>

<%- include('partials/intro') %>
<%- include('partials/nav') %>

<!-- Page header -->
<section class="page-header">
  <div class="container">
    <h1 class="section-h2">What's on the <span class="hi">shelves.</span></h1>
    <p class="page-header-lede">Two days, packed with performances, try-outs, and CCA showcases.</p>
  </div>
</section>

<!-- Schedule -->
<section class="prog-section">
  <div class="container">

    <!-- Day tabs -->
    <div class="prog-tabs">
      <button class="prog-tab active-tab" data-day="all">All days</button>
      <button class="prog-tab" data-day="13">Thu 13 Aug</button>
      <button class="prog-tab" data-day="14">Fri 14 Aug</button>
    </div>

    <!-- Programme cards -->
    <div id="prog-list" class="prog-list">

      <!-- Day 13 -->
      <div class="prog-card prog-card--thu" data-day="13">
        <div class="prog-card-header">
          <span class="prog-card-daynum">13</span>
          <div>
            <div class="prog-card-dow">THU · 13 AUG 2026</div>
            <div class="prog-card-daytitle">Opening Day</div>
          </div>
        </div>
        <div class="prog-card-body">
          <div class="prog-slot">
            <div class="prog-slot-time">10:00</div>
            <div>
              <div class="prog-slot-title">Doors Open · CCA Booths</div>
              <div class="prog-slot-desc">SMU Concourse, L1 · All CCAs set up and ready</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">11:00</div>
            <div>
              <div class="prog-slot-title">Official Opening Ceremony</div>
              <div class="prog-slot-desc">SMU Concourse · Ribbon-cutting & school umbrella parade</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">12:00</div>
            <div>
              <div class="prog-slot-title">Free Tote Giveaway</div>
              <div class="prog-slot-desc">First 500 attendees · Limited stock</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">14:00</div>
            <div>
              <div class="prog-slot-title">ACF Showcase Performance</div>
              <div class="prog-slot-desc">SMU Concourse Stage · Arts & Cultural showcase</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">18:00</div>
            <div>
              <div class="prog-slot-title">Doors Close</div>
              <div class="prog-slot-desc">See you tomorrow!</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Day 14 -->
      <div class="prog-card prog-card--fri" data-day="14">
        <div class="prog-card-header">
          <span class="prog-card-daynum">14</span>
          <div>
            <div class="prog-card-dow">FRI · 14 AUG 2026</div>
            <div class="prog-card-daytitle">Closing Night</div>
          </div>
        </div>
        <div class="prog-card-body">
          <div class="prog-slot">
            <div class="prog-slot-time">10:00</div>
            <div>
              <div class="prog-slot-title">Final Day · All Booths Open</div>
              <div class="prog-slot-desc">SMU Concourse, L1 · Last chance to sign up</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">14:00</div>
            <div>
              <div class="prog-slot-title">SMUX Adventure Demo</div>
              <div class="prog-slot-desc">SMU Concourse · Outdoor and adventure gear showcase</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">16:00</div>
            <div>
              <div class="prog-slot-title">SSU Sports Finals</div>
              <div class="prog-slot-desc">SOA Courts · Friendly exhibition matches</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">18:00</div>
            <div>
              <div class="prog-slot-title">Closing Performance & Grand Finale</div>
              <div class="prog-slot-desc">Li Ka Shing Library · Performances, prize-giving, send-off</div>
            </div>
          </div>
          <div class="prog-slot">
            <div class="prog-slot-time">21:00</div>
            <div>
              <div class="prog-slot-title">Vivace 2026 closes</div>
              <div class="prog-slot-desc">Thank you for being part of the haul ♥</div>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Day-tab filter — toggles .active-tab and shows/hides matching prog-cards.
  const tabs = document.querySelectorAll('.prog-tab');
  const cards = document.querySelectorAll('.prog-card');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active-tab'));
      tab.classList.add('active-tab');
      const day = tab.dataset.day;
      cards.forEach(card => {
        card.style.display = (day === 'all' || card.dataset.day === day) ? 'block' : 'none';
      });
    });
  });
</script>

<%- include('partials/footer') %>

</body>
</html>
