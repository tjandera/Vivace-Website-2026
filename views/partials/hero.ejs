<!-- Hero -->
<section class="hero basket-hero" id="home">
  <div class="hero-glow"></div>
  <div class="basket-hero-wrap">

    <!-- ── Logo + event info ── -->
    <div class="basket-hero-copy">
      <a href="/about" class="hero-logo-link" aria-label="About Vivace '26">
        <img class="hero-logo-img" src="/assets/basket-elements-pile.png" alt="Vivace '26">
      </a>
      <div class="hero-meta">
        <span>13 – 14 August 2026</span>
        <span>SMU Concourse</span>
        <span>10:00 – 18:00</span>
      </div>
    </div>

    <!-- ── YouTube trailer embed ── -->
    <!-- To update: replace the `src` video ID (the part after /embed/) with the actual Vivace '26 trailer ID -->
    <div class="hero-video">
      <iframe
        src="https://www.youtube.com/embed/oTPjD5d5lbo"
        title="SMU Vivace Trailer"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <!-- ── Shelf zone — locked to the bottom of the hero ──
         The "Find your CCA" sign, arrow, CTA pills, and shelf art all live
         inside this zone so they travel together as one bottom-anchored
         cluster (basket-zone has margin-top:auto in hero.css). -->
    <div class="basket-zone">
      <p class="basket-zone-quote" style="display:none"></p>
      <div class="find-cca-sign" aria-hidden="true">
        <img src="assets/resources-design/find_your_cca1.png" alt="">
      </div>

      <div class="find-cca-arrow" aria-hidden="true">
        <svg viewBox="0 0 56 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M28 4 L28 48" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
          <path d="M8 34 L28 56 L48 34" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <!-- CTA pills sit right above the shelf, hugging its top edge. -->
      <div class="basket-hero-actions">
        <a class="btn primary" href="/explore"><span>Explore CCA</span><span class="arrow">-></span></a>
        <a class="btn ghost" href="/about"><span>About Vivace</span></a>
      </div>

      <!--
        Shelf scene — the "unbox the best of SMU" fruit shelves.
        The crate + logo artwork is one flat PNG (shelf-art). Over each crate's
        logo sits a .shelf-crate button; each button carries a matching logo
        overlay (.crate-logo) that sits statically on top of the baked-in logo,
        ready for future per-logo interactions. Hotspot coordinates live in
        models/schools.js (school.shelf.hotspot).
      -->
      <div class="shelf-scene" id="scene" aria-label="Fruit shelves — pick a school umbrella to explore">
        <img class="shelf-art" src="assets/new_shelve_design.png" alt="Vivace fruit shelves with the seven SMU school umbrellas" fetchpriority="high">

        <% schools.forEach(school => { %>
          <button
            class="shelf-crate"
            data-cat="<%= school.id %>"
            data-title="<%= school.name %>"
            data-count="<%= school.count %>"
            data-aisle="<%= school.aisle %>"
            style="<%= school.shelf.hotspot %>"
            aria-label="Explore <%= school.fullName %>"
          >
            <img class="crate-logo" src="<%= school.basket.img %>" alt="" loading="lazy">
            <span class="crate-label"><%= school.fullName %></span>
          </button>
        <% }) %>
      </div>
    </div>

  </div>
</section>

<!-- Receipt marquee strip -->
<div class="receipt-strip">
  <div class="receipt-marquee" aria-hidden="true">
    <span>★ <i>Vivace</i> Mart est. 2026 ★ &emsp;<em>Aisle 7</em>&emsp; · ACF · <i>SICS</i> · ICON · <em>SMUX</em> · SSU · <i>GRI</i> &emsp;·&emsp; <strong>Academic</strong> &emsp;★&emsp; Free entry &emsp;★</span>
    <span>★ <i>Vivace</i> Mart est. 2026 ★ &emsp;<em>Aisle 7</em>&emsp; · ACF · <i>SICS</i> · ICON · <em>SMUX</em> · SSU · <i>GRI</i> &emsp;·&emsp; <strong>Academic</strong> &emsp;★&emsp; Free entry &emsp;★</span>
  </div>
</div>
